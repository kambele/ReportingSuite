<%@ Page Title="Support" Language="VB" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Contact.aspx.vb" Inherits="ReportingSuite.Contact" %>

<asp:Content ID="BodyContent" ContentPlaceHolderID="MainContent" runat="server">
    <section class="reporting-info-card" aria-labelledby="support-title">
        <h2 id="support-title"><i class="icon-lifebuoy text-primary mr-2"></i>Reporting support</h2>
        <p>Use the approved NAMFISA ICT support channel for access issues, unavailable reports, unexpected report results, or technical failures.</p>
        <p class="text-muted">Include the report name, selected parameters, the time of the issue, and a screenshot where appropriate. Do not include confidential report data unless the support channel is approved for it.</p>
    </section>
</asp:Content>
