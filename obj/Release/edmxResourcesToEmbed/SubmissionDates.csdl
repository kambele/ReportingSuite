<?xml version="1.0" encoding="utf-8"?>
<Schema Namespace="ReportingSuiteModel" Alias="Self" annotation:UseStrongSpatialTypes="false" xmlns:annotation="http://schemas.microsoft.com/ado/2009/02/edm/annotation" xmlns:customannotation="http://schemas.microsoft.com/ado/2013/11/edm/customannotation" xmlns="http://schemas.microsoft.com/ado/2009/11/edm">
  <EntityContainer Name="SubmissionDates" annotation:LazyLoadingEnabled="true">
    <FunctionImport Name="GetSubmissionPacksDates" ReturnType="Collection(ReportingSuiteModel.GetSubmissionPacksDates_Result)">
      <Parameter Name="start" Mode="In" Type="DateTime" />
      <Parameter Name="end" Mode="In" Type="DateTime" />
      <Parameter Name="type" Mode="In" Type="String" />
      <Parameter Name="formset" Mode="In" Type="String" />
      <Parameter Name="status" Mode="In" Type="String" />
      <Parameter Name="entity" Mode="In" Type="Int64" />
    </FunctionImport>
  </EntityContainer>
  <ComplexType Name="GetSubmissionPacksDates_Result">
    <Property Type="String" Name="Company_Name" Nullable="true" MaxLength="100" />
    <Property Type="String" Name="License_Number" Nullable="true" MaxLength="50" />
    <Property Type="String" Name="Industry" Nullable="true" MaxLength="100" />
    <Property Type="DateTime" Name="Submission_Date" Nullable="true" Precision="23" />
    <Property Type="String" Name="reference" Nullable="true" MaxLength="250" />
    <Property Type="String" Name="submission_pack_name" Nullable="true" MaxLength="250" />
    <Property Type="DateTime" Name="end_date" Nullable="true" Precision="23" />
    <Property Type="DateTime" Name="created_on" Nullable="true" Precision="23" />
    <Property Type="String" Name="action_performed" Nullable="true" MaxLength="50" />
    <Property Type="String" Name="FormStatusName" Nullable="true" MaxLength="50" />
    <Property Type="String" Name="FormName" Nullable="true" />
  </ComplexType>
</Schema>